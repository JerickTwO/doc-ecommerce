---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
---

<footer class="bg-gray-950 text-gray-400">
  <div
    class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <a href="/" class="inline-flex items-center bg-white rounded-lg px-3 py-1.5">
      <Image src={logo} alt="Perseo Ecommerce" class="h-6 w-auto" />
    </a>

    <p class="text-sm text-center sm:text-left">
      © <span id="current-year"></span> Perseo Ecommerce Documentación. Creado
      por
      <a
        class="text-white underline underline-offset-2 hover:text-red-400 transition-colors"
        href="https://empresarios365.com"
        target="_blank"
        rel="noopener noreferrer">PERSEO</a
      >.
    </p>

    <a
      class="text-sm text-gray-400 hover:text-white transition-colors"
      href="https://ecommerce-demo.com/"
      target="_blank"
      rel="noopener noreferrer">Perseo Ecommerce Demo ↗</a
    >
  </div>

  <script>
    const year = new Date().getFullYear();
    const element = document.getElementById("current-year");
    if (element) element.innerText = year.toString();
  </script>
</footer>
