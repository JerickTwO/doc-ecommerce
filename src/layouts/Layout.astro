---
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

export interface Props {
  title: string;
  currentPage?: string;
}

const { title, currentPage } = Astro.props;

const navItems = [
  { href: "/caracteristicas", label: "Características", id: "caracteristicas" },
  { href: "/implementacion", label: "Implementación", id: "implementacion" },
  { href: "/requisitos", label: "Requisitos", id: "requisitos" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Documentación oficial de Perseo Ecommerce"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="../assets/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900">
    <header class="sticky top-0 z-10 border-b border-gray-100 bg-white/95 backdrop-blur">
      <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16 gap-6">
        <a href="/" class="flex items-center gap-2 shrink-0">
          <Image src={logo} alt="Perseo Ecommerce" class="h-8 w-auto" />
        </a>

        <nav
          class="flex items-center gap-6 sm:gap-8 text-sm font-medium overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none]"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`whitespace-nowrap transition-colors ${
                  currentPage === item.id
                    ? "text-red-600 font-semibold"
                    : "text-gray-600 hover:text-gray-900"
                }`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <a
          href="https://ecommerce-demo.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 bg-red-600 text-white text-sm font-semibold px-4 py-2 rounded-full hover:bg-red-700 transition-colors shrink-0"
        >
          Ver Demo
        </a>
      </div>
    </header>

    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
  }

  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }

  nav::-webkit-scrollbar {
    display: none;
  }
</style>
