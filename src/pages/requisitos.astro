---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import imageRequirements from "../assets/requirements.png";
import twoImageRequirements from "../assets/requirementsTwo.png";
---

<Layout title="Requisitos - Perseo Ecommerce" currentPage="requisitos">
  <section class="bg-gray-950 text-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-red-500 font-semibold text-sm uppercase tracking-wide mb-3">
        Documentación
      </p>
      <h1 class="text-4xl font-extrabold mb-3">Requisitos</h1>
      <p class="text-gray-400 max-w-xl">
        Todo lo que tu catálogo necesita para verse impecable en el
        ecommerce, desde imágenes hasta categorías.
      </p>
    </div>
  </section>

  <main class="max-w-6xl mx-auto px-6 py-16">
    <section class="mb-14">
      <h2 class="text-xl font-bold text-gray-900 mb-2">
        Productos parametrizados
      </h2>
      <p class="text-gray-600 mb-8 max-w-2xl">
        Deben tener los productos parametrizados con imágenes, categorías o
        líneas, precios y ficha técnica para una correcta visualización en el
        ecommerce.
      </p>

      <div class="grid sm:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-gray-100 p-5">
          <p class="text-sm font-semibold text-red-600 uppercase tracking-wide mb-3">
            Parametrización de producto
          </p>
          <Image
            loading="lazy"
            src={imageRequirements}
            class="w-full rounded-xl border border-gray-100 cursor-pointer zoom-image"
            alt="Imagen de ejemplo de requerimientos."
            data-zoom-src={imageRequirements.src}
          />
        </div>

        <div class="rounded-2xl border border-gray-100 p-5">
          <p class="text-sm font-semibold text-red-600 uppercase tracking-wide mb-3">
            Ficha técnica
          </p>
          <Image
            loading="lazy"
            src={twoImageRequirements}
            class="w-full rounded-xl border border-gray-100 cursor-pointer zoom-image"
            alt="Segunda imagen de ejemplo de requerimientos."
            data-zoom-src={twoImageRequirements.src}
          />
        </div>
      </div>
    </section>

    <section class="grid sm:grid-cols-2 gap-6 mb-14">
      <div class="rounded-2xl border border-gray-100 p-8">
        <div class="w-10 h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center mb-4">
          🖼️
        </div>
        <h2 class="text-lg font-bold text-gray-900 mb-2">Imágenes</h2>
        <p class="text-gray-600 text-sm">
          Los productos deben tener una configuración para las imágenes,
          puede ser fondo blanco o sin fondo, esto es discutido de acuerdo a
          la personalización de la página. La resolución mínima permitida es
          <span class="font-semibold text-gray-900">800x600</span> en formato
          webp de preferencia.
        </p>
      </div>
      <div class="rounded-2xl border border-gray-100 p-8">
        <div class="w-10 h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center mb-4">
          🏷️
        </div>
        <h2 class="text-lg font-bold text-gray-900 mb-2">
          Nombres de Producto
        </h2>
        <p class="text-gray-600 text-sm">
          Los productos deben tener nombres cortos,
          <span class="font-semibold text-gray-900">máximo 58 caracteres</span>
          incluyendo espacios y signos de puntuación.
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-gray-950 text-white p-8 sm:p-10">
      <h2 class="text-xl font-bold mb-5">Configuración de categorías</h2>
      <ul class="space-y-2 text-gray-300 text-sm mb-8">
        <li class="flex gap-2">
          <span class="text-red-500 font-bold">●</span>
          Deben ser nombres claros y precisos, además de no ser tan extensos
          y de preferencia que tengan 2 a 3 palabras
        </li>
        <li class="flex gap-2">
          <span class="text-red-500 font-bold">●</span>
          La imagen que represente la categoría debe ser mínimo en 800x600
        </li>
      </ul>

      <h3 class="text-sm font-semibold text-red-400 uppercase tracking-wide mb-3">
        Adicionales
      </h3>
      <ul class="space-y-2 text-gray-300 text-sm">
        <li class="flex gap-2">
          <span class="text-red-500 font-bold">●</span>
          Debe contar con un logo de empresa, esto es necesario para
          desarrollar los recursos de la página
        </li>
        <li class="flex gap-2">
          <span class="text-red-500 font-bold">●</span>
          En caso de ser Perseo PC debe contar con IP pública apuntada al
          servidor local, además de tener el API KEY previamente instalada
          por el técnico a cargo.
        </li>
      </ul>
    </section>

    <!-- Modal de Zoom -->
    <div
      id="zoomModal"
      class="fixed inset-0 bg-black/80 flex items-center justify-center z-20 opacity-0 invisible transition-all duration-300 ease-in-out touch-none"
    >
      <div
        class="w-full h-full md:max-w-[90vw] md:max-h-[90vh] md:w-auto md:h-auto p-2 md:p-4 flex items-center justify-center"
      >
        <button
          id="closeModal"
          class="absolute top-4 right-4 md:top-2 md:right-2 bg-white rounded-full w-12 h-12 md:w-10 md:h-10 flex items-center justify-center text-gray-800 hover:bg-gray-100 active:bg-gray-200 transition-colors duration-200 z-10 shadow touch-manipulation"
          aria-label="Cerrar imagen"
        >
          <svg
            class="w-6 h-6 md:w-5 md:h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <img
          id="zoomedImage"
          src=""
          loading="lazy"
          alt=""
          class="max-w-full max-h-full w-auto h-auto object-contain rounded-lg shadow-2xl select-none"
        />
      </div>
    </div>
  </main>
</Layout>

<style>
  .zoom-modal-open {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .modal-open {
    overflow: hidden !important;
  }

  #zoomModal {
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  #zoomedImage {
    transition: opacity 0.3s ease-in-out;
    max-width: calc(100vw - 1rem);
    max-height: calc(100vh - 1rem);
  }

  .zoom-image:hover {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  @media (hover: none) and (pointer: coarse) {
    .zoom-image:active {
      transform: scale(0.98);
      transition: transform 0.1s ease;
    }
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    #zoomedImage {
      max-width: calc(100vw - 2rem);
      max-height: calc(100vh - 2rem);
    }

    .zoom-image {
      max-width: 100%;
      height: auto;
    }
  }

  @media (max-width: 767px) {
    .zoom-image {
      max-width: 100%;
      height: auto;
      width: auto !important;
    }

    #zoomedImage {
      max-width: calc(100vw - 0.5rem);
      max-height: calc(100vh - 0.5rem);
    }

    #closeModal {
      min-width: 48px;
      min-height: 48px;
    }
  }

  #zoomModal img {
    touch-action: pan-x pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
</style>

<script>
  // Bloqueo de scroll simple: solo alterna overflow en <html>.
  // Evitamos el truco de position:fixed + top negativo porque, si la
  // página queda restaurada desde el bfcache del navegador (botones
  // atrás/adelante) con el modal abierto, ese estado se congela y
  // bloquea visualmente toda la página (incluido el navbar).
  let closeTimeout: ReturnType<typeof setTimeout> | undefined;

  function lockScroll() {
    document.documentElement.style.overflow = "hidden";
    document.addEventListener("touchmove", preventTouch, { passive: false });
  }

  function unlockScroll() {
    document.documentElement.style.removeProperty("overflow");
    document.removeEventListener("touchmove", preventTouch);
  }

  function preventTouch(e: TouchEvent) {
    e.preventDefault();
  }

  function openModal(imageSrc: string, imageAlt: string) {
    const modal = document.getElementById("zoomModal");
    const zoomedImage = document.getElementById("zoomedImage");

    if (modal && zoomedImage && zoomedImage instanceof HTMLImageElement) {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = undefined;
      }

      lockScroll();

      zoomedImage.src = imageSrc;
      zoomedImage.alt = imageAlt;

      modal.classList.add("zoom-modal-open");
      document.body.classList.add("modal-open");

      modal.focus();
    }
  }

  function closeModal() {
    const modal = document.getElementById("zoomModal");

    if (modal) {
      modal.classList.remove("zoom-modal-open");
      document.body.classList.remove("modal-open");

      if (closeTimeout) clearTimeout(closeTimeout);
      closeTimeout = setTimeout(() => {
        unlockScroll();
        closeTimeout = undefined;
      }, 300);
    }
  }

  // Red de seguridad: si el navegador restaura esta página desde el
  // bfcache (navegación atrás/adelante) con el modal abierto, forzamos
  // el cierre y liberamos el scroll para que la página no quede bloqueada.
  window.addEventListener("pageshow", (e) => {
    if ((e as PageTransitionEvent).persisted) {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = undefined;
      }
      const modal = document.getElementById("zoomModal");
      modal?.classList.remove("zoom-modal-open");
      document.body.classList.remove("modal-open");
      unlockScroll();
    }
  });

  document.addEventListener("DOMContentLoaded", function () {
    const zoomImages = document.querySelectorAll(".zoom-image");

    zoomImages.forEach((img) => {
      img.addEventListener("click", function (this: HTMLImageElement) {
        const imageSrc = this.getAttribute("data-zoom-src") || this.src;
        const imageAlt = this.alt;
        openModal(imageSrc, imageAlt);
      });

      img.addEventListener("keydown", function (this: HTMLImageElement, e) {
        const evt = e as KeyboardEvent;
        if (evt.key === "Enter" || evt.key === " ") {
          evt.preventDefault();
          const imageSrc = this.getAttribute("data-zoom-src") || this.src;
          const imageAlt = this.alt;
          openModal(imageSrc, imageAlt);
        }
      });
    });

    const closeButton = document.getElementById("closeModal");
    closeButton?.addEventListener("click", closeModal);

    const modal = document.getElementById("zoomModal");
    modal?.addEventListener("click", function (e) {
      if (e.target === this) {
        closeModal();
      }
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        closeModal();
      }
    });
  });
</script>
