---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Implementación - Perseo Ecommerce" currentPage="implementacion">
  <section class="bg-gray-950 text-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-red-500 font-semibold text-sm uppercase tracking-wide mb-3">
        Documentación
      </p>
      <h1 class="text-4xl font-extrabold mb-3">Implementación</h1>
      <p class="text-gray-400 max-w-xl">
        Pruebas exhaustivas y puesta en producción con acompañamiento
        completo, de contacto inicial a lanzamiento.
      </p>
    </div>
  </section>

  <main class="max-w-6xl mx-auto px-6 py-16">
    <section class="mb-14">
      <h2 class="text-xl font-bold text-gray-900 mb-6">
        Proceso de Implementación
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          [
            {
              step: "1",
              title: "Personalización",
              desc: "Adaptación del diseño y funcionalidades según necesidades.",
            },
            {
              step: "2",
              title: "Carga de Productos",
              desc: "Sincronización en tiempo real con sistema contable Perseo.",
            },
            {
              step: "3",
              title: "Pagos y Envíos",
              desc: "Integración de pasarelas y métodos de entrega.",
            },
            {
              step: "4",
              title: "Lanzamiento",
              desc: "Pruebas finales y puesta en producción.",
            },
          ].map((item) => (
            <div class="rounded-2xl border border-gray-100 p-6">
              <div class="w-9 h-9 rounded-full bg-red-600 text-white flex items-center justify-center font-bold text-sm mb-4">
                {item.step}
              </div>
              <h3 class="font-semibold text-gray-900 mb-1.5">{item.title}</h3>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-xl font-bold text-gray-900 mb-6">
        Actividades de lanzamiento
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          [
            "Pruebas de funcionalidad en ambiente de desarrollo",
            "Validación de procesos de compra completos",
            "Verificación de integraciones con sistemas externos",
            "Capacitación del equipo administrativo",
            "Migración a producción y monitoreo inicial",
            "Soporte técnico",
          ].map((item) => (
            <div class="rounded-xl border border-gray-100 p-4 text-sm text-gray-700 hover:border-red-200 transition-colors">
              <span class="text-red-600 font-bold mr-1">✓</span> {item}
            </div>
          ))
        }
      </div>
    </section>

    <section class="grid lg:grid-cols-2 gap-6 mb-14">
      <div class="rounded-2xl border border-gray-100 p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-5">
          Tiempo de Implementación
        </h2>
        <dl class="divide-y divide-gray-100">
          <div class="flex justify-between py-2.5 text-sm">
            <dt class="text-gray-600">Contacto con el cliente</dt>
            <dd class="text-gray-900 font-semibold">1-2 días</dd>
          </div>
          <div class="flex justify-between py-2.5 text-sm">
            <dt class="text-gray-600">Personalización</dt>
            <dd class="text-gray-900 font-semibold">1-3 días</dd>
          </div>
          <div class="flex justify-between py-2.5 text-sm">
            <dt class="text-gray-600">Parametrización a medida</dt>
            <dd class="text-gray-900 font-semibold">1-2 días</dd>
          </div>
          <div class="flex justify-between py-2.5 text-sm">
            <dt class="text-gray-600">Producción</dt>
            <dd class="text-gray-900 font-semibold">1 día</dd>
          </div>
        </dl>
        <div class="mt-4 rounded-xl bg-red-50 px-4 py-3 flex justify-between items-center">
          <span class="text-sm font-semibold text-gray-900">Tiempo Total</span>
          <span class="text-red-600 font-bold">4-9 días</span>
        </div>
      </div>

      <div class="rounded-2xl bg-gray-950 text-white p-8">
        <h2 class="text-xl font-bold mb-5">Soporte Incluido</h2>
        <ul class="space-y-4">
          <li class="flex gap-3">
            <span class="text-red-500 font-bold">●</span>
            <div>
              <p class="text-sm font-semibold">Capacitación Completa</p>
              <p class="text-sm text-gray-400">
                Entrenamiento para tu equipo en el uso de la plataforma
              </p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="text-red-500 font-bold">●</span>
            <div>
              <p class="text-sm font-semibold">Soporte Técnico 24/7</p>
              <p class="text-sm text-gray-400">
                Asistencia técnica disponible durante el lanzamiento
              </p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="text-red-500 font-bold">●</span>
            <div>
              <p class="text-sm font-semibold">Documentación Detallada</p>
              <p class="text-sm text-gray-400">
                Manuales de usuario y guías de administración
              </p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="text-red-500 font-bold">●</span>
            <div>
              <p class="text-sm font-semibold">Actualizaciones Gratuitas</p>
              <p class="text-sm text-gray-400">
                Mejoras y nuevas funcionalidades sin costo adicional
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
